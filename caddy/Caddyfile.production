{
    email   james.guan.data@gmail.com
}

(static) {
	@static {
		file
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.json
	}
	header @static Cache-Control max-age=5184000
}

(security) {
	header {
		# enable HSTS
		Strict-Transport-Security max-age=31536000;
		# disable clients from sniffing the media type
		X-Content-Type-Options nosniff
		# keep referrer data off of HTTP connections
		Referrer-Policy no-referrer-when-downgrade
	}
}

crime-api.james-guan.info {
	encode zstd gzip
	import static
	import security

	# Route API requests to broker service
	@api {
		path /users/* /crimes/* /patrols/* /admin/*
	}
	reverse_proxy @api http://broker-service:8080

	# Route everything else to frontend
	reverse_proxy http://front-end:80
}

broker.james-guan.info {
	reverse_proxy http://broker-service:8080
}

tg.james-guan.info {
	encode zstd gzip
	import security

	@webhook_post {
		path /telegram/webhook
		method POST
	}
	@health_get {
		path /healthz
		method GET
	}

	@webhook_wrong {
		path /telegram/webhook
		not { method POST }
	}
	@health_wrong {
		path /healthz
		not { method GET }
	}
	handle @webhook_wrong { respond 405 }
	handle @health_wrong { respond 405 }

	# Choose ONE of these upstreams:
	# If Caddy shares a network with the bot service:
	# reverse_proxy @webhook_post telegram-bot:9095
	# reverse_proxy @health_get  telegram-bot:9095

	# If Caddy runs on host or different network and bot publishes 9095:
	reverse_proxy @webhook_post localhost:9095
	reverse_proxy @health_get  localhost:9095

	handle { respond 404 }
}